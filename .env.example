# Proseforge environment — copy to .dev.vars for local dev (NEVER commit .dev.vars).
# Workers AI (default): no key needed on Cloudflare; the `ai` binding is enough.
AI_PROVIDER=workers-ai
AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8
# OpenAI-compatible provider (only if AI_PROVIDER=openai-compatible):
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY is a SECRET — set with: npx wrangler secret put AI_API_KEY
# Limits (optional overrides):
# MAX_TEXT_CHARS=100000
# RATE_LIMIT_PER_MINUTE=30
# AI_TIMEOUT_MS=60000
# ALLOWED_ORIGINS=https://proseforge.example.com
