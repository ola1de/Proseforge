{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration.schema.json",
  "name": "proseforge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "DOCS_BUCKET", "bucket_name": "proseforge-docs" }],
  "d1_databases": [{ "binding": "DB", "database_name": "proseforge-db", "database_id": "REPLACE_WITH_REAL_ID_AFTER_CREATION", "migrations_dir": "migrations" }],
  "queues": { "producers": [{ "binding": "DOC_QUEUE", "queue": "proseforge-doc-jobs" }], "consumers": [{ "queue": "proseforge-doc-jobs", "max_batch_size": 5, "max_retries": 2 }] },
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "MAX_TEXT_CHARS": "100000",
    "RATE_LIMIT_PER_MINUTE": "30",
    "AI_TIMEOUT_MS": "90000",
    "ALLOWED_ORIGINS": ""
  },
  "observability": { "enabled": true }
}
